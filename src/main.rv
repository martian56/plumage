// Demo launcher. Run with: rvpm run -- [dashboard|todo]
from std.env import args
from std.io import println
import std.string
from "../examples/dashboard" import dashboard_main
from "../examples/todo" import todo_main

fun main() {
    let a = args()
    var pick = "dashboard"
    if a.len() > 1 {
        pick = a[1]
    }
    var ok = true
    if pick == "todo" {
        ok = todo_main()
    } else {
        if pick == "dashboard" {
            ok = dashboard_main()
        } else {
            println("usage: rvpm run -- [dashboard|todo]")
            return
        }
    }
    if not ok {
        println("plumage needs an interactive terminal; run this from a real console")
    }
}
