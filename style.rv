// Colors and text attributes for buffer cells. A Style is plain data; the
// SGR encoding happens once, in sgr_codes, so the renderer and the tests
// agree on exactly what a style means.

// Terminal colors: the classic named set, the 256-color palette by index,
// and 24-bit RGB. Default is whatever the terminal was already using.
enum Color {
    Default,
    Black,
    Red,
    Green,
    Yellow,
    Blue,
    Magenta,
    Cyan,
    White,
    Gray,
    Indexed(int),
    Rgb(int, int, int),
}

class Style {
    fg: Color
    bg: Color
    bold: bool
    dim: bool
    italic: bool
    underline: bool
    reverse: bool
    strike: bool
}

impl Style {
    fun new() -> Style {
        return Style(
            fg: Color.Default,
            bg: Color.Default,
            bold: false,
            dim: false,
            italic: false,
            underline: false,
            reverse: false,
            strike: false,
        )
    }

    // Each builder returns a fresh Style, so a base can branch safely.
    fun fg(self, c: Color) -> Style {
        let s = self._copy()
        s.fg = c
        return s
    }

    fun bg(self, c: Color) -> Style {
        let s = self._copy()
        s.bg = c
        return s
    }

    fun bold(self) -> Style {
        let s = self._copy()
        s.bold = true
        return s
    }

    fun dim(self) -> Style {
        let s = self._copy()
        s.dim = true
        return s
    }

    fun italic(self) -> Style {
        let s = self._copy()
        s.italic = true
        return s
    }

    fun underline(self) -> Style {
        let s = self._copy()
        s.underline = true
        return s
    }

    fun reverse(self) -> Style {
        let s = self._copy()
        s.reverse = true
        return s
    }

    fun strike(self) -> Style {
        let s = self._copy()
        s.strike = true
        return s
    }

    fun _copy(self) -> Style {
        return Style(
            fg: self.fg,
            bg: self.bg,
            bold: self.bold,
            dim: self.dim,
            italic: self.italic,
            underline: self.underline,
            reverse: self.reverse,
            strike: self.strike,
        )
    }
}

// The SGR parameter list for a style, always starting from a reset so a
// cell's appearance never depends on what was drawn before it.
fun sgr_codes(s: Style) -> list[int] {
    let out: list[int] = []
    out.push(0)
    if s.bold {
        out.push(1)
    }
    if s.dim {
        out.push(2)
    }
    if s.italic {
        out.push(3)
    }
    if s.underline {
        out.push(4)
    }
    if s.reverse {
        out.push(7)
    }
    if s.strike {
        out.push(9)
    }
    _push_color(out, s.fg, 30, 38)
    _push_color(out, s.bg, 40, 48)
    return out
}

// Whether two styles draw the same, without building any strings: the
// renderer asks this for every cell of every frame.
fun same_style(a: Style, b: Style) -> bool {
    if color_code(a.fg) != color_code(b.fg) or color_code(a.bg) != color_code(b.bg) {
        return false
    }
    return a.bold == b.bold and a.dim == b.dim and a.italic == b.italic and a.underline == b.underline and a.reverse == b.reverse and a.strike == b.strike
}

// A color as one int: -1 default, 0 to 9 named, 100 + n indexed, and
// 1000000 + 0xRRGGBB for RGB.
fun color_code(c: Color) -> int {
    return match c {
        case Default { -1 }
        case Black { 0 }
        case Red { 1 }
        case Green { 2 }
        case Yellow { 3 }
        case Blue { 4 }
        case Magenta { 5 }
        case Cyan { 6 }
        case White { 7 }
        case Gray { 8 }
        case Indexed(n) { 100 + n }
        case Rgb(r, g, b) { 1000000 + r * 65536 + g * 256 + b }
    }
}

// A comparable fingerprint, used by the renderer to detect style changes.
fun style_key(s: Style) -> str {
    let codes = sgr_codes(s)
    var key = ""
    var i = 0
    while i < codes.len() {
        key = "${key};${codes[i]}"
        i = i + 1
    }
    return key
}

// Append the codes for one color. base is 30 for foreground and 40 for
// background; ext is the 38 or 48 extended-color introducer.
fun _push_color(out: list[int], c: Color, base: int, ext: int) {
    match c {
        case Default {}
        case Black { out.push(base) }
        case Red { out.push(base + 1) }
        case Green { out.push(base + 2) }
        case Yellow { out.push(base + 3) }
        case Blue { out.push(base + 4) }
        case Magenta { out.push(base + 5) }
        case Cyan { out.push(base + 6) }
        case White { out.push(base + 7) }
        case Gray { out.push(base + 60) }
        case Indexed(n) {
            out.push(ext)
            out.push(5)
            out.push(n)
        }
        case Rgb(r, g, b) {
            out.push(ext)
            out.push(2)
            out.push(r)
            out.push(g)
            out.push(b)
        }
    }
}
