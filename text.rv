// Styled text: spans, lines, wrapping, and alignment. Widgets that show
// text build on these instead of raw strings, so one line can mix styles.

import std.string
from "github.com/martian56/wingspan" import width, truncate
from "./style" import Style

// A run of text in one style.
class Span {
    text: str
    style: Style
}

impl Span {
    fun raw(text: str) -> Span {
        return Span(text: text, style: Style.new())
    }

    fun styled(text: str, style: Style) -> Span {
        return Span(text: text, style: style)
    }
}

// One display line, a sequence of spans.
class Line {
    spans: list[Span]
}

impl Line {
    fun raw(text: str) -> Line {
        return Line(spans: [Span.raw(text)])
    }

    fun styled(text: str, style: Style) -> Line {
        return Line(spans: [Span.styled(text, style)])
    }

    fun from_spans(spans: list[Span]) -> Line {
        return Line(spans: spans)
    }

    // Display columns over all spans.
    fun width(self) -> int {
        var total = 0
        var i = 0
        while i < self.spans.len() {
            total = total + width(self.spans[i].text)
            i = i + 1
        }
        return total
    }
}

enum Align {
    Left,
    Center,
    Right,
}

// The x offset that aligns a line of the given width inside avail columns.
fun align_offset(align: Align, line_width: int, avail: int) -> int {
    let d = avail - line_width
    if d <= 0 {
        return 0
    }
    return match align {
        case Left { 0 }
        case Center { d / 2 }
        case Right { d }
    }
}

// Word-wrap text into lines of at most max columns, breaking on spaces and
// hard-splitting any word wider than the limit. Existing newlines are kept.
fun wrap(text: str, max: int) -> list[str] {
    let out: list[str] = []
    if max <= 0 {
        return out
    }
    let paragraphs = text.lines()
    var p = 0
    while p < paragraphs.len() {
        _wrap_paragraph(out, paragraphs[p], max)
        p = p + 1
    }
    return out
}

fun _wrap_paragraph(out: list[str], para: str, max: int) {
    if width(para) <= max {
        out.push(para)
        return
    }
    let words = para.split(" ")
    var line = ""
    var line_w = 0
    var i = 0
    while i < words.len() {
        let word = words[i]
        let ww = width(word)
        if ww > max {
            // A word wider than the limit: flush, then hard-split it.
            if line_w > 0 {
                out.push(line)
                line = ""
                line_w = 0
            }
            var rest = word
            while width(rest) > max {
                let head = truncate(rest, max)
                out.push(head)
                rest = rest.substring(head.length(), rest.length())
            }
            line = rest
            line_w = width(rest)
        } else {
            if line_w == 0 {
                line = word
                line_w = ww
            } else {
                if line_w + 1 + ww <= max {
                    line = "${line} ${word}"
                    line_w = line_w + 1 + ww
                } else {
                    out.push(line)
                    line = word
                    line_w = ww
                }
            }
        }
        i = i + 1
    }
    if line_w > 0 or out.len() == 0 {
        out.push(line)
    }
}
