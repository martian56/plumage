// A one-row tab bar. Highlights the selected title; you draw the matching
// content below it.

import std.string
from "github.com/martian56/wingspan" import truncate, width
from "../buffer" import Buffer, Widget
from "../layout" import Rect
from "../style" import Style

class Tabs {
    titles: list[str]
    selected: int
    style: Style
    highlight_style: Style
    divider: str
}

impl Tabs {
    fun new(titles: list[str]) -> Tabs {
        return Tabs(
            titles: titles,
            selected: 0,
            style: Style.new(),
            highlight_style: Style.new().reverse(),
            divider: " | ",
        )
    }

    fun selected(self, i: int) -> Tabs {
        return Tabs(
            titles: self.titles,
            selected: i,
            style: self.style,
            highlight_style: self.highlight_style,
            divider: self.divider,
        )
    }

    fun style(self, s: Style) -> Tabs {
        return Tabs(
            titles: self.titles,
            selected: self.selected,
            style: s,
            highlight_style: self.highlight_style,
            divider: self.divider,
        )
    }

    fun highlight_style(self, s: Style) -> Tabs {
        return Tabs(
            titles: self.titles,
            selected: self.selected,
            style: self.style,
            highlight_style: s,
            divider: self.divider,
        )
    }

    fun divider(self, d: str) -> Tabs {
        return Tabs(
            titles: self.titles,
            selected: self.selected,
            style: self.style,
            highlight_style: self.highlight_style,
            divider: d,
        )
    }
}

impl Widget for Tabs {
    fun render(self, area: Rect, buf: Buffer) {
        if area.is_empty() {
            return
        }
        var x = area.x
        var i = 0
        while i < self.titles.len() {
            let rem = area.x + area.w - x
            if rem <= 0 {
                return
            }
            var sty = self.style
            if i == self.selected {
                sty = self.highlight_style
            }
            x = buf.set_string(x, area.y, truncate(self.titles[i], rem), sty)
            if i < self.titles.len() - 1 {
                let drem = area.x + area.w - x
                if drem > 0 {
                    x = buf.set_string(x, area.y, truncate(self.divider, drem), self.style)
                }
            }
            i = i + 1
        }
        return
    }
}
