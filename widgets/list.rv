// A selectable list that scrolls to keep the selection visible. Selection
// lives in your model as a plain index; build the widget fresh each frame.

import std.string
from "github.com/martian56/wingspan" import truncate, width, pad_right
from "../buffer" import Buffer, Widget
from "../layout" import Rect
from "../style" import Style

class ListView {
    items: list[str]
    selected: int
    style: Style
    highlight_style: Style
    marker: str
}

impl ListView {
    // A list with nothing selected. Pass -1 to selected for the same.
    fun new(items: list[str]) -> ListView {
        return ListView(
            items: items,
            selected: -1,
            style: Style.new(),
            highlight_style: Style.new().reverse(),
            marker: "> ",
        )
    }

    fun selected(self, i: int) -> ListView {
        return ListView(
            items: self.items,
            selected: i,
            style: self.style,
            highlight_style: self.highlight_style,
            marker: self.marker,
        )
    }

    fun style(self, s: Style) -> ListView {
        return ListView(
            items: self.items,
            selected: self.selected,
            style: s,
            highlight_style: self.highlight_style,
            marker: self.marker,
        )
    }

    fun highlight_style(self, s: Style) -> ListView {
        return ListView(
            items: self.items,
            selected: self.selected,
            style: self.style,
            highlight_style: s,
            marker: self.marker,
        )
    }

    fun marker(self, m: str) -> ListView {
        return ListView(
            items: self.items,
            selected: self.selected,
            style: self.style,
            highlight_style: self.highlight_style,
            marker: m,
        )
    }

    // First visible row, chosen so the selection stays on screen.
    fun _offset(self, h: int) -> int {
        if self.selected < 0 or h <= 0 {
            return 0
        }
        if self.selected < h {
            return 0
        }
        return self.selected - h + 1
    }
}

impl Widget for ListView {
    fun render(self, area: Rect, buf: Buffer) {
        if area.is_empty() {
            return
        }
        let pad = " ".repeat(width(self.marker))
        let offset = self._offset(area.h)
        var row = 0
        while row < area.h and offset + row < self.items.len() {
            let i = offset + row
            let picked = i == self.selected
            var lead = pad
            var sty = self.style
            if picked {
                lead = self.marker
                sty = self.highlight_style
            }
            let text = truncate("${lead}${self.items[i]}", area.w)
            let line = pad_right(text, area.w)
            buf.set_string(area.x, area.y + row, line, sty)
            row = row + 1
        }
        return
    }
}
